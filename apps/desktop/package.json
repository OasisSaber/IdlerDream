{
  "name": "@idlerdream/desktop",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/main.js",
    "build": "vite build && tsc -p electron/tsconfig.json && electron-builder --dir",
    "dist": "vite build && tsc -p electron/tsconfig.json && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@idlerdream/protocol": "0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.oasis.idlerdream",
    "productName": "IdlerDream",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../sidecar/dist/idlerdream-sidecar.exe",
        "to": "sidecar/idlerdream-sidecar.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/app-icon.ico",
      "uninstallerIcon": "resources/app-icon.ico"
    }
  }
}
